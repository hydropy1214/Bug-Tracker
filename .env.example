# SentinelX — required environment variables
# Copy this to .env for local development outside Replit.
# On Replit, set these through the Secrets panel and the environment configuration.

# ── Runtime-managed by Replit (do NOT set manually on Replit) ─────────────────
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# ── Required secrets ──────────────────────────────────────────────────────────
# At least 32 random characters — used to derive the AES-256-GCM key for
# encrypting authenticated scan headers stored in the database.
SESSION_SECRET=change_me_to_a_random_64_char_secret

# ── Service ports ─────────────────────────────────────────────────────────────
# API server port — must match the Vite proxy target (apps/web/vite.config.ts)
API_PORT=8080

# ── CORS (production only) ────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins in production.
# Replit preview domains (*.replit.dev, *.repl.co) are always allowed.
# ALLOWED_ORIGINS=https://your-domain.com

# ── Misc ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
